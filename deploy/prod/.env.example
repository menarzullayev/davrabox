# Copy to .env (git-ignored) and fill in EVERY value. Generate secrets with: openssl rand -base64 36
# The stack refuses to start while a required value is missing.

# --- public identity ---
PUBLIC_HOST=davrabox.example.org          # DNS name served by Caddy (A/AAAA record -> this host)
SITE_ADDRESS=davrabox.example.org         # normally identical to PUBLIC_HOST; http://host:80 when TLS ends at a proxy
ACME_EMAIL=ops@example.org                # Let's Encrypt registration/expiry notices

# --- shared-host variant only (docker-compose.shared-host.yml) ---
# TURN_HOST=turn.davrabox.example.org      # DNS-only A record to this host; LiveKit TURN over TLS on 443

# --- release ---
GHCR_OWNER=menarzullayev
DAVRA_TAG=sha-REPLACE_ME                  # image tag from the Publish workflow (or a vX.Y.Z tag)

# --- databases ---
POSTGRES_PASSWORD=
APP_DB_PASSWORD=

# --- identity provider ---
KEYCLOAK_ADMIN_PASSWORD=                  # bootstrap admin of the master realm (operator console via ssh tunnel only)
ADMIN_API_CLIENT_SECRET=                  # at least 32 chars; service account the API uses to manage users

# --- email (Keycloak: verification + password reset; decision 1 of 2026-11-27, docs/email-and-social-signin.md) ---
# Brevo SMTP relay of the DavraBox-only Brevo account. Applied to the realm by scripts/keycloak-onboarding.mjs (not read by
# a container directly). The owner puts the key here himself; never paste it anywhere else.
KC_SMTP_HOST=smtp-relay.brevo.com
KC_SMTP_PORT=587
KC_SMTP_USER=                             # the Brevo SMTP login (looks like 1234ab001@smtp-brevo.com)
KC_SMTP_PASSWORD=                         # the Brevo SMTP key
KC_SMTP_FROM=no-reply@mail.davrabox.bugvector.uz
KC_SMTP_FROM_NAME=DavraBox

# --- Google / Microsoft sign-in (optional; decision 4). Empty = the buttons are not shown. ---
# Redirect URIs to register in the provider consoles: https://<PUBLIC_HOST>/auth/realms/davrabox/broker/google/endpoint
# and https://<PUBLIC_HOST>/auth/realms/davrabox/broker/microsoft/endpoint
IDP_GOOGLE_CLIENT_ID=
IDP_GOOGLE_CLIENT_SECRET=
IDP_MICROSOFT_CLIENT_ID=
IDP_MICROSOFT_CLIENT_SECRET=

# --- media server ---
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=                       # at least 32 chars

# --- file sharing ---
S3_ACCESS_KEY=
S3_SECRET_KEY=                            # at least 16 chars
FILE_MASTER_KEY=                          # base64 of 32 random bytes: openssl rand -base64 32

# --- reverse proxy ---
SIGNUP_TRUSTED_PROXY_HOPS=1                # proxies in front of the API that append to X-Forwarded-For (Caddy alone = 1; Cloudflare tunnel + Caddy = 2). Used by EVERY rate limit.

# --- help assistant (optional, docs/help-assistant.md) ---
# Empty key = the assistant answers from the FAQ only. The owner creates the key in the Anthropic console (billing + a
# monthly spend limit there, decision: $20); never paste it anywhere but this file.
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-haiku-5-5
ASSISTANT_DAILY_USD_CAP=0.60              # application-side daily cap in USD; above it the assistant falls back to FAQ mode
PLATFORM_OWNER_SUBS=                      # Keycloak user id(s) of the platform owner: the only people who can read stored conversations

# --- calendar integration (optional, docs/calendar.md) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# --- observability (docker-compose.observability.yml; docs/observability.md) ---
# Only needed when you start the observability stack. Telegram bot token and chat id are FILES in deploy/prod/secrets/, not here.
GRAFANA_ADMIN_PASSWORD=
GLITCHTIP_SECRET_KEY=                     # openssl rand -hex 32
GLITCHTIP_DB_PASSWORD=
GLITCHTIP_ENABLE_REGISTRATION=false       # the first GlitchTip account can always register; true only to let a colleague sign up
# Error tracking is OFF while these are empty. Fill them after creating the projects in GlitchTip (see docs/observability.md):
GLITCHTIP_DSN=                            # API (server) DSN: http://<key>@glitchtip:8000/<project id>
GLITCHTIP_WEB_DSN=                        # browser DSN: https://<key>@<PUBLIC_HOST>/_obs/<project id>
