{
  "realm": "davrabox",
  "enabled": true,
  "displayName": "DavraBox",
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "bruteForceProtected": true,
  "failureFactor": 5,
  "maxFailureWaitSeconds": 900,
  "passwordPolicy": "length(12) and notUsername",
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "internationalizationEnabled": true,
  "supportedLocales": [
    "uz",
    "ru",
    "en"
  ],
  "defaultLocale": "uz",
  "roles": {
    "realm": [
      {
        "name": "org_admin",
        "description": "Organization administrator"
      },
      {
        "name": "member",
        "description": "Regular member"
      }
    ]
  },
  "clients": [
    {
      "clientId": "davrabox-web",
      "name": "DavraBox Web",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "protocol": "openid-connect",
      "redirectUris": [
        "https://${PUBLIC_HOST}/*",
        "https://localhost:8443/*",
        "https://davrabox.bugvector.uz/*"
      ],
      "webOrigins": [
        "https://${PUBLIC_HOST}",
        "https://localhost:8443",
        "https://davrabox.bugvector.uz"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "protocolMappers": [
        {
          "name": "org_slug",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "org_slug",
            "claim.name": "org_slug",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "davrabox-admin-api",
      "name": "DavraBox Admin API (service account)",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${ADMIN_API_CLIENT_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "protocol": "openid-connect"
    }
  ],
  "users": [
    {
      "username": "admin.demo",
      "email": "admin.demo@davrabox.local",
      "firstName": "Admin",
      "lastName": "Demo",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "${DEMO_USER_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": [
        "org_admin",
        "member"
      ],
      "attributes": {
        "org_slug": [
          "demo"
        ]
      }
    },
    {
      "username": "user.demo",
      "email": "user.demo@davrabox.local",
      "firstName": "User",
      "lastName": "Demo",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "${DEMO_USER_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": [
        "member"
      ],
      "attributes": {
        "org_slug": [
          "demo"
        ]
      }
    },
    {
      "username": "service-account-davrabox-admin-api",
      "enabled": true,
      "serviceAccountClientId": "davrabox-admin-api",
      "clientRoles": {
        "realm-management": [
          "view-users",
          "manage-users",
          "view-realm",
          "query-users"
        ]
      }
    }
  ],
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\": [{\"name\": \"username\", \"displayName\": \"${username}\", \"validations\": {\"length\": {\"min\": 3, \"max\": 255}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}}, {\"name\": \"email\", \"displayName\": \"${email}\", \"validations\": {\"email\": {}, \"length\": {\"max\": 255}}, \"required\": {\"roles\": [\"user\"]}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}}, {\"name\": \"firstName\", \"displayName\": \"${firstName}\", \"validations\": {\"length\": {\"max\": 255}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}}, {\"name\": \"lastName\", \"displayName\": \"${lastName}\", \"validations\": {\"length\": {\"max\": 255}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}}, {\"name\": \"org_slug\", \"displayName\": \"Organization\", \"validations\": {\"pattern\": {\"pattern\": \"^[a-z0-9][a-z0-9-]{1,62}$\", \"error-message\": \"invalid organization slug\"}}, \"permissions\": {\"view\": [\"admin\"], \"edit\": [\"admin\"]}}]}"
          ]
        }
      }
    ]
  },
  "loginTheme": "davrabox"
}