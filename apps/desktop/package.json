{
  "name": "@davrabox/desktop",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "DavraBox desktop app (secure Electron shell around the web client)",
  "author": "DavraBox",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "pnpm build && electron .",
    "dist": "pnpm build && node scripts/dist.mjs --dir",
    "dist:release": "pnpm build && node scripts/dist.mjs",
    "verify-signature": "node scripts/verify-signature.mjs"
  },
  "devDependencies": {
    "@electron/fuses": "^1.8.0",
    "@types/node": "^22.10.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.2",
    "vitest": "^5.1.1"
  },
  "build": {
    "appId": "uz.davrabox.desktop",
    "productName": "DavraBox",
    "copyright": "All rights reserved",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**"
    ],
    "asar": true,
    "protocols": [
      {
        "name": "DavraBox",
        "schemes": [
          "davrabox"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "verifyUpdateCodeSignature": true
    },
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.business",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true,
      "extendInfo": {
        "NSCameraUsageDescription": "DavraBox uses the camera for video meetings.",
        "NSMicrophoneUsageDescription": "DavraBox uses the microphone for meetings."
      }
    },
    "linux": {
      "target": [
        "dir"
      ],
      "category": "Network",
      "executableName": "davrabox"
    },
    "publish": {
      "provider": "github",
      "owner": "menarzullayev",
      "repo": "davrabox",
      "releaseType": "release"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
